APP_NAME="Lentera"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Default pakai SQLite supaya gampang jalanin lokal tanpa setup server DB.
# Ganti ke mysql kalau mau: DB_CONNECTION=mysql lalu isi DB_HOST, DB_DATABASE, dst.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@lentera.test"
MAIL_FROM_NAME="Lentera"

# Midtrans sandbox, untuk fitur unlock game (opsional)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
